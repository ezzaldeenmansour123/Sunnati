# SUNNATI .gitignore — Phase 1
# Flutter / Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
*.iml
.idea/
.vscode/
*.log

# Android signing — NEVER commit a keystore or its passwords.
android/app/keystore.jks
android/app/*.jks
android/key.properties
android/app/key.properties
*.keystore
key.properties
# EXCEPTION: the committed stable DEBUG keystore (public standard Android
# debug credentials — install identity only, no security). It MUST be in
# the repo so every CI build shares one signature (see
# android/app/build.gradle). Release keystores stay out, always.
!tools/debug.keystore

# Built artefacts (rebuilt in CI — see tools/build_db.py and build.yml)
assets/sunnati.db
assets/sunnati.db.sha256
assets/narrators.db
assets/narrators.db.sha256
assets/fonts/Amiri-Regular.ttf
assets/fonts/Amiri-Bold.ttf

# Local tooling
local.properties
__pycache__/
*.pyc
